<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NewStart</AssemblyName><Product>New Start</Product><Title>New Start (Beta)</Title>
    <Version>0.1.0-beta.1</Version><AssemblyVersion>0.1.0.0</AssemblyVersion><FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-beta.1</InformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>assets/NewStart.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Content Include="native/build/NewStart.Backdrop.dll" Link="NewStart.Backdrop.dll" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>

